msgid "Style"
msgstr "Estilo"

#: prefs.js:304
msgid "Zoom"
msgstr "Zoom"

#: prefs.js:305 prefs.js:327
msgid "Slide"
msgstr "Deslizar"

#: prefs.js:306
msgid "Unfold"
msgstr "Desdobrar"

#: prefs.js:307 prefs.js:332
msgid "Fade"
msgstr "Esmaecer"

#: prefs.js:308 prefs.js:333
msgid "None"
msgstr "Nenhuma"

#: prefs.js:310 prefs.js:335
msgid "Duration (ms)"
msgstr "Duração (ms)"

#: prefs.js:311
msgid "Closing takes 70% of it"
msgstr "O fechamento leva 70% dela"

#: prefs.js:312 prefs.js:336
msgid "Curve"
msgstr "Curva"

#: prefs.js:313
msgid "Distance (%)"
msgstr "Distância (%)"

