msgid "Glides to the next result"
msgstr "Desliza até o próximo resultado"

#: prefs.js:319
msgid "Reaches over both, then lets go"
msgstr "Estica sobre os dois e depois solta"

#: prefs.js:320
msgid "A drop that flows down the list"
msgstr "Uma gota que escorre pela lista"

#: prefs.js:321
msgid "Wobbles into place"
msgstr "Oscila até se acomodar"

#: prefs.js:322
msgid "Shrinks away and pops up again"
msgstr "Encolhe e reaparece"

#: prefs.js:323
msgid "Fades out and in again"
msgstr "Some e reaparece aos poucos"

#: prefs.js:324
msgid "Jumps at once"
msgstr "Pula de uma vez"

#: prefs.js:328
msgid "Stretch"
msgstr "Esticar"

#: prefs.js:329
msgid "Liquid"
msgstr "Líquido"

#: prefs.js:330
msgid "Jelly"
msgstr "Gelatina"

#: prefs.js:331
msgid "Pop"
msgstr "Estalo"

#: prefs.js:337
msgid "Rebound (%)"
msgstr "Rebote (%)"

