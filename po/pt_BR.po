msgstr "Ações do sistema"

#: prefs.js:418
msgid "Lock, log out, power off…"
msgstr "Bloquear, encerrar sessão, desligar…"

#: prefs.js:420
msgid "GNOME search providers"
msgstr "Provedores de pesquisa do GNOME"

#: prefs.js:421
msgid ""
"The bar searches with the providers GNOME uses: those turned off in "
"Settings › Search find nothing here either."
msgstr ""
"A barra pesquisa com os provedores que o GNOME usa: os desligados em "
"Configurações › Pesquisa também não encontram nada aqui."

#: prefs.js:441
msgid "Turned off in Settings › Search"
msgstr "Desligado em Configurações › Pesquisa"

#: prefs.js:447
msgid "No search providers are installed"
msgstr "Nenhum provedor de pesquisa instalado"

#: prefs.js:450
msgid "Open Search Settings"
msgstr "Abrir configurações de pesquisa"

#: prefs.js:464
msgid "Behavior"
msgstr "Comportamento"

#: prefs.js:466
msgid "Shortcut"
msgstr "Atalho"

#: prefs.js:466
