#: prefs.js:180
msgid "Disabled"
msgstr "Desativado"

#: prefs.js:188
msgid "Change"
msgstr "Alterar"

#: prefs.js:190
msgid "Press the keys to use, with Ctrl, Alt or Super. Escape cancels."
msgstr "Pressione as teclas desejadas, com Ctrl, Alt ou Super. Esc cancela."

#: prefs.js:192
msgid "New shortcut"
msgstr "Novo atalho"

#: prefs.js:196 prefs.js:533
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:197
msgid "Disable"
msgstr "Desativar"

#: prefs.js:223
#, javascript-format
msgid ""
"%s cannot be the shortcut alone: every app would lose that key. Add Ctrl, "
"Alt or Super; only keys such as F1 to F12 or Print work alone."
msgstr ""
"%s não pode ser o atalho sozinha: todos os aplicativos perderiam essa tecla. "
"Adicione Ctrl, Alt ou Super; só teclas como F1 a F12 ou Print funcionam "
"sozinhas."

#: prefs.js:256
msgid "Smooth"
msgstr "Suave"

#: prefs.js:257
msgid "Overshoot"
msgstr "Exagerada"

#: prefs.js:258
msgid "Bounce"
msgstr "Saltitante"

#: prefs.js:259
msgid "Elastic"
msgstr "Elástica"

#: prefs.js:260
msgid "Linear"
msgstr "Linear"

#: prefs.js:264
msgid "Appearance"
msgstr "Aparência"

#: prefs.js:266
msgid "Size"
msgstr "Tamanho"

#: prefs.js:267
msgid ""
"Width and rows also change by dragging the grip at the bar's bottom-right "
"corner."
msgstr ""
"A largura e as linhas também mudam arrastando a alça no canto inferior "
"direito da barra."

#: prefs.js:268
msgid "Width (px)"
msgstr "Largura (px)"

#: prefs.js:269
msgid "Rows shown"
msgstr "Linhas visíveis"

#: prefs.js:269
msgid "More results scroll"
msgstr "Mais resultados rolam"

#: prefs.js:270
msgid "Icon size (px)"
msgstr "Tamanho dos ícones (px)"

#: prefs.js:271
msgid "Text size (px)"
msgstr "Tamanho do texto (px)"

#: prefs.js:271
msgid "0 uses the theme's size"
msgstr "0 usa o tamanho do tema"

#: prefs.js:272
msgid "Show descriptions"
msgstr "Mostrar descrições"

#: prefs.js:273
msgid "A second line: a file's folder, an open window's app"
msgstr "Uma segunda linha: a pasta de um arquivo, o app de uma janela"

#: prefs.js:274
msgid "Show where results come from"
msgstr "Mostrar a origem dos resultados"

#: prefs.js:276
msgid "Highlight"
msgstr "Destaque"

#: prefs.js:277
msgid "Custom color"
msgstr "Cor personalizada"

#: prefs.js:278
msgid "Use this color instead of the system accent color"
msgstr "Usar esta cor em vez da cor de destaque do sistema"

#: prefs.js:279
msgid "Opacity (%)"
msgstr "Opacidade (%)"

#: prefs.js:280 prefs.js:286
msgid "Corner radius (px)"
msgstr "Raio dos cantos (px)"

#: prefs.js:281
msgid "Border width (px)"
msgstr "Largura da borda (px)"

#: prefs.js:281
msgid "0 draws no border"
msgstr "0 não desenha borda"

#: prefs.js:282
msgid "Selected icon size (%)"
msgstr "Tamanho do ícone selecionado (%)"

#: prefs.js:283
msgid "100 turns the growth off"
msgstr "100 desliga o crescimento"

#: prefs.js:285
msgid "Bar"
msgstr "Barra"

#: prefs.js:287
msgid "Background opacity (%)"
msgstr "Opacidade do fundo (%)"

#: prefs.js:288
msgid "Darken the screen behind (%)"
msgstr "Escurecer a tela atrás (%)"

#: prefs.js:289
msgid "0 leaves the screen as it is"
msgstr "0 deixa a tela como está"

#: prefs.js:292
msgid "Animation"
msgstr "Animação"

#: prefs.js:294 prefs.js:465
msgid "Opening"
msgstr "Abertura"

#: prefs.js:295
msgid ""
"Animations follow GNOME's Animations setting: with animations off, they are "
"instant."
msgstr ""
"As animações seguem a configuração Animações do GNOME: com elas desligadas, "
"tudo é instantâneo."

#: prefs.js:297
msgid "Grows from a little smaller"
msgstr "Cresce a partir de um pouco menor"

#: prefs.js:298
msgid "Drops in from above"
msgstr "Desce de cima"

#: prefs.js:299
msgid "Opens downwards like a menu"
msgstr "Abre para baixo como um menu"

#: prefs.js:300
msgid "Fades in where it is"
msgstr "Surge aos poucos no lugar"

#: prefs.js:301
msgid "Appears at once"
msgstr "Aparece de uma vez"

