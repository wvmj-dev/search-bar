#: prefs.js:498
msgid "Save position and size"
msgstr "Salvar posição e tamanho"

#: prefs.js:499
msgid "Off: moving and resizing last until the bar closes"
msgstr "Desligado: mover e redimensionar valem até a barra fechar"

