msgid "How far overshoot, bounce and elastic go"
msgstr "Quanto as curvas exagerada, saltitante e elástica passam do ponto"

#: prefs.js:340
msgid "Fine-tuning"
msgstr "Ajuste fino"

#: prefs.js:342
msgid "Reach (%)"
msgstr "Alcance (%)"

#: prefs.js:343
msgid "Share of the time spent reaching over both"
msgstr "Parte do tempo gasta esticando sobre os dois"

#: prefs.js:344
msgid "How liquid (%)"
msgstr "Quão líquido (%)"

#: prefs.js:345
msgid "More: the head runs ahead, the neck thins"
msgstr "Mais: a cabeça vai na frente, o pescoço afina"

#: prefs.js:347
msgid "Bounce (%)"
msgstr "Quique (%)"

#: prefs.js:348
msgid "Wobbles"
msgstr "Oscilações"

#: prefs.js:349
msgid "Stretch (%)"
msgstr "Estiramento (%)"

#: prefs.js:349
msgid "How much it stretches while moving"
msgstr "Quanto estica enquanto se move"

#: prefs.js:351
msgid "Smallest size (%)"
msgstr "Menor tamanho (%)"

#: prefs.js:352
msgid "Size it shrinks to before jumping"
msgstr "Tamanho a que encolhe antes de pular"

#: prefs.js:354
msgid "Results"
msgstr "Resultados"

#: prefs.js:355
msgid "Animate the list"
msgstr "Animar a lista"

#: prefs.js:356
msgid "The list grows and shrinks smoothly and new rows fade in"
msgstr ""
"A lista cresce e encolhe suavemente e as novas linhas surgem aos poucos"

#: prefs.js:362
msgid "Not used by this style"
msgstr "Não usado por este estilo"

#: prefs.js:378
msgid "Used by overshoot, bounce and elastic"
msgstr "Usado pelas curvas exagerada, saltitante e elástica"

#: prefs.js:388
msgid "Sources"
