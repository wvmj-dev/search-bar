#: prefs.js:180
msgid "Disabled"
msgstr "Desactivado"

#: prefs.js:188
msgid "Change"
msgstr "Cambiar"

#: prefs.js:190
msgid "Press the keys to use, with Ctrl, Alt or Super. Escape cancels."
msgstr "Pulse las teclas que quiera usar, con Ctrl, Alt o Super. Esc cancela."

#: prefs.js:192
msgid "New shortcut"
msgstr "Nuevo atajo"

#: prefs.js:196 prefs.js:533
msgid "Cancel"
msgstr "Cancelar"

#: prefs.js:197
msgid "Disable"
msgstr "Desactivar"

#: prefs.js:223
#, javascript-format
msgid ""
"%s cannot be the shortcut alone: every app would lose that key. Add Ctrl, "
"Alt or Super; only keys such as F1 to F12 or Print work alone."
msgstr ""
"%s no puede ser el atajo por sí sola: todas las aplicaciones perderían esa "
"tecla. Añada Ctrl, Alt o Super; solo teclas como F1 a F12 o Impr funcionan "
"solas."

#: prefs.js:256
msgid "Smooth"
msgstr "Suave"

#: prefs.js:257
msgid "Overshoot"
msgstr "Sobrepasar"

#: prefs.js:258
msgid "Bounce"
msgstr "Rebotar"

#: prefs.js:259
msgid "Elastic"
msgstr "Elástico"

#: prefs.js:260
msgid "Linear"
msgstr "Lineal"

#: prefs.js:264
msgid "Appearance"
msgstr "Apariencia"

#: prefs.js:266
msgid "Size"
msgstr "Tamaño"

#: prefs.js:267
msgid ""
"Width and rows also change by dragging the grip at the bar's bottom-right "
"corner."
msgstr ""
"El ancho y las filas también cambian arrastrando el asa de la esquina "
"inferior derecha de la barra."

#: prefs.js:268
msgid "Width (px)"
msgstr "Ancho (px)"

#: prefs.js:269
msgid "Rows shown"
msgstr "Filas visibles"

#: prefs.js:269
msgid "More results scroll"
msgstr "Los demás resultados se desplazan"

#: prefs.js:270
msgid "Icon size (px)"
msgstr "Tamaño de los iconos (px)"

#: prefs.js:271
msgid "Text size (px)"
msgstr "Tamaño del texto (px)"

#: prefs.js:271
msgid "0 uses the theme's size"
msgstr "0 usa el tamaño del tema"

#: prefs.js:272
msgid "Show descriptions"
msgstr "Mostrar descripciones"

#: prefs.js:273
msgid "A second line: a file's folder, an open window's app"
msgstr "Una segunda línea: la carpeta de un archivo, la app de una ventana"

#: prefs.js:274
msgid "Show where results come from"
msgstr "Mostrar de dónde vienen los resultados"

#: prefs.js:276
msgid "Highlight"
msgstr "Resaltado"

#: prefs.js:277
msgid "Custom color"
msgstr "Color personalizado"

#: prefs.js:278
msgid "Use this color instead of the system accent color"
msgstr "Usar este color en lugar del color de acento del sistema"

#: prefs.js:279
msgid "Opacity (%)"
msgstr "Opacidad (%)"

#: prefs.js:280 prefs.js:286
msgid "Corner radius (px)"
msgstr "Radio de las esquinas (px)"

#: prefs.js:281
msgid "Border width (px)"
msgstr "Ancho del borde (px)"

#: prefs.js:281
msgid "0 draws no border"
msgstr "0 no dibuja borde"

#: prefs.js:282
msgid "Selected icon size (%)"
msgstr "Tamaño del icono seleccionado (%)"

#: prefs.js:283
msgid "100 turns the growth off"
msgstr "100 desactiva el crecimiento"

#: prefs.js:285
msgid "Bar"
msgstr "Barra"

#: prefs.js:287
msgid "Background opacity (%)"
msgstr "Opacidad del fondo (%)"

#: prefs.js:288
msgid "Darken the screen behind (%)"
msgstr "Oscurecer la pantalla detrás (%)"

#: prefs.js:289
msgid "0 leaves the screen as it is"
msgstr "0 deja la pantalla como está"

#: prefs.js:292
msgid "Animation"
msgstr "Animación"

#: prefs.js:294 prefs.js:465
msgid "Opening"
msgstr "Apertura"

#: prefs.js:295
msgid ""
"Animations follow GNOME's Animations setting: with animations off, they are "
"instant."
msgstr ""
"Las animaciones siguen el ajuste Animaciones de GNOME: si están "
"desactivadas, todo es instantáneo."

#: prefs.js:297
msgid "Grows from a little smaller"
msgstr "Crece desde un poco más pequeña"

#: prefs.js:298
msgid "Drops in from above"
msgstr "Baja desde arriba"

#: prefs.js:299
msgid "Opens downwards like a menu"
msgstr "Se abre hacia abajo como un menú"

#: prefs.js:300
msgid "Fades in where it is"
msgstr "Aparece gradualmente en su sitio"

#: prefs.js:301
msgid "Appears at once"
msgstr "Aparece de golpe"

#: prefs.js:303 prefs.js:326
msgid "Style"
msgstr "Estilo"

#: prefs.js:304
msgid "Zoom"
msgstr "Zoom"

#: prefs.js:305 prefs.js:327
msgid "Slide"
msgstr "Deslizar"

#: prefs.js:306
msgid "Unfold"
msgstr "Desplegar"

#: prefs.js:307 prefs.js:332
msgid "Fade"
msgstr "Fundido"

#: prefs.js:308 prefs.js:333
msgid "None"
msgstr "Ninguna"

#: prefs.js:310 prefs.js:335
msgid "Duration (ms)"
msgstr "Duración (ms)"

#: prefs.js:311
msgid "Closing takes 70% of it"
msgstr "El cierre dura el 70 %"

#: prefs.js:312 prefs.js:336
msgid "Curve"
msgstr "Curva"

#: prefs.js:313
msgid "Distance (%)"
msgstr "Distancia (%)"

#: prefs.js:314 prefs.js:367
msgid "How small zoom starts, how far slide comes from"
msgstr "Lo pequeño que empieza el zoom, lo lejos que viene el deslizar"

#: prefs.js:316
msgid "Selection"
msgstr "Selección"

#: prefs.js:318
msgid "Glides to the next result"
msgstr "Se desliza al siguiente resultado"

#: prefs.js:319
msgid "Reaches over both, then lets go"
msgstr "Se estira sobre ambos y luego suelta"

#: prefs.js:320
msgid "A drop that flows down the list"
msgstr "Una gota que fluye por la lista"

#: prefs.js:321
msgid "Wobbles into place"
msgstr "Tiembla hasta asentarse"

#: prefs.js:322
msgid "Shrinks away and pops up again"
msgstr "Se encoge y vuelve a aparecer"

#: prefs.js:323
msgid "Fades out and in again"
msgstr "Se desvanece y vuelve a aparecer"

#: prefs.js:324
msgid "Jumps at once"
msgstr "Salta de golpe"

#: prefs.js:328
msgid "Stretch"
msgstr "Estirar"

#: prefs.js:329
msgid "Liquid"
msgstr "Líquido"

#: prefs.js:330
msgid "Jelly"
msgstr "Gelatina"

#: prefs.js:331
msgid "Pop"
msgstr "Pop"

#: prefs.js:337
msgid "Rebound (%)"
msgstr "Rebote (%)"

#: prefs.js:338 prefs.js:377
msgid "How far overshoot, bounce and elastic go"
msgstr "Cuánto se pasan sobrepasar, rebotar y elástico"

#: prefs.js:340
msgid "Fine-tuning"
msgstr "Ajuste fino"

#: prefs.js:342
msgid "Reach (%)"
msgstr "Alcance (%)"

#: prefs.js:343
msgid "Share of the time spent reaching over both"
msgstr "Parte del tiempo que pasa estirándose sobre ambos"

#: prefs.js:344
msgid "How liquid (%)"
msgstr "Cuán líquido (%)"

#: prefs.js:345
msgid "More: the head runs ahead, the neck thins"
msgstr "Más: la cabeza se adelanta, el cuello se adelgaza"

#: prefs.js:347
msgid "Bounce (%)"
msgstr "Rebote (%)"

#: prefs.js:348
msgid "Wobbles"
msgstr "Oscilaciones"

#: prefs.js:349
msgid "Stretch (%)"
msgstr "Estiramiento (%)"

#: prefs.js:349
msgid "How much it stretches while moving"
msgstr "Cuánto se estira mientras se mueve"

#: prefs.js:351
msgid "Smallest size (%)"
msgstr "Tamaño mínimo (%)"

#: prefs.js:352
msgid "Size it shrinks to before jumping"
msgstr "Tamaño al que se encoge antes de saltar"

#: prefs.js:354
msgid "Results"
msgstr "Resultados"

#: prefs.js:355
msgid "Animate the list"
msgstr "Animar la lista"

#: prefs.js:356
msgid "The list grows and shrinks smoothly and new rows fade in"
msgstr ""
"La lista crece y se encoge con suavidad y las filas nuevas aparecen "
"gradualmente"

#: prefs.js:362
msgid "Not used by this style"
msgstr "No lo usa este estilo"

#: prefs.js:378
msgid "Used by overshoot, bounce and elastic"
msgstr "Lo usan sobrepasar, rebotar y elástico"

#: prefs.js:388
msgid "Sources"
msgstr "Fuentes"

#: prefs.js:389
msgid "Built in"
msgstr "Integradas"

#: prefs.js:415
msgid "Applications"
msgstr "Aplicaciones"

#: prefs.js:415
msgid "Installed apps"
msgstr "Apps instaladas"

#: prefs.js:416
msgid "Open windows"
msgstr "Ventanas abiertas"

#: prefs.js:416
msgid "Find a window by its title or app"
msgstr "Busca una ventana por su título o app"

#: prefs.js:418
msgid "System actions"
msgstr "Acciones del sistema"

#: prefs.js:418
msgid "Lock, log out, power off…"
msgstr "Bloquear, cerrar sesión, apagar…"

#: prefs.js:420
msgid "GNOME search providers"
msgstr "Proveedores de búsqueda de GNOME"

#: prefs.js:421
msgid ""
"The bar searches with the providers GNOME uses: those turned off in "
"Settings › Search find nothing here either."
msgstr ""
"La barra busca con los proveedores que usa GNOME: los desactivados en "
"Configuración › Búsqueda tampoco encuentran nada aquí."

#: prefs.js:441
msgid "Turned off in Settings › Search"
msgstr "Desactivado en Configuración › Búsqueda"

#: prefs.js:447
msgid "No search providers are installed"
msgstr "No hay proveedores de búsqueda instalados"

#: prefs.js:450
msgid "Open Search Settings"
msgstr "Abrir la configuración de búsqueda"

#: prefs.js:464
msgid "Behavior"
msgstr "Comportamiento"

#: prefs.js:466
msgid "Shortcut"
msgstr "Atajo"

#: prefs.js:466
msgid "Opens and closes the bar"
msgstr "Abre y cierra la barra"

