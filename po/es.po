#: prefs.js:491
msgid "Down (%)"
msgstr "Vertical (%)"

#: prefs.js:492
msgid "0 is the top, 100 the bottom"
msgstr "0 es arriba, 100 abajo"

#: prefs.js:498
msgid "Save position and size"
msgstr "Guardar posición y tamaño"

#: prefs.js:499
